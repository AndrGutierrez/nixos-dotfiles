[Desktop Entry]
Type=Application
Name=Files
Comment=Access and organize files
Exec=env GTK_CSD=0 GTK_USE_PORTAL=1 nautilus --new-window %U
Icon=org.gnome.Nautilus
Terminal=false
Categories=GNOME;GTK;Utility;Core;FileManager;
MimeType=inode/directory;
StartupNotify=true
DBusActivatable=false
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=env GTK_CSD=0 GTK_USE_PORTAL=1 nautilus --new-window
